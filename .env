# TCloud Configuration
# Получите значения на https://my.telegram.org -> API development tools
# Эти значения идентифицируют приложение, а не пользователя. Серверных секретов нет.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=placeholder_replace_with_real_hash

# Demo mode: когда true, приложение использует mock-транспорт вместо реального MTProto.
# Это позволяет протестировать весь UI/UX без реальных Telegram-кредов.
TCLOUD_DEMO_MODE=true
