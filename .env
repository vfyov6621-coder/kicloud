# kicloud — конфигурация
# Получено на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=30840671
TELEGRAM_API_HASH=45d7a93d5a14b90a1e596b311844fcb9

# Demo mode: когда true, используется mock-транспорт вместо реального подключения к Telegram.
# Установите false для работы с реальным Telegram-аккаунтом (после деплоя на ваш домен).
KICLOUD_DEMO_MODE=true

# Public URL для GitHub Pages — измените на свой домен после деплоя.
# Пример: https://username.github.io/kicloud или https://kicloud.example.com
NEXT_PUBLIC_BASE_PATH=

# Firestore (опционально) — для синхронизации метаданных между устройствами.
# Создайте проект на https://console.firebase.google.com, включите Firestore.
# Скопируйте конфиг из Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
