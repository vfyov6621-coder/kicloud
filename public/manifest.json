{
  "name": "TCloud — Telegram Cloud Storage",
  "short_name": "TCloud",
  "description": "Облачное хранилище файлов, использующее Telegram в качестве бессерверного бэкенда. Клиентский MTProto, AES-256-CBC шифрование, Apple Liquid Glass дизайн.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f2f2f7",
  "theme_color": "#000000",
  "categories": ["productivity", "utilities", "storage"],
  "lang": "ru",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Файлы",
      "short_name": "Files",
      "url": "/?view=files",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Корзина",
      "short_name": "Trash",
      "url": "/?view=trash",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Настройки",
      "short_name": "Settings",
      "url": "/?view=settings",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}
