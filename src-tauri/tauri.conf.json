{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCloud",
  "version": "2.0.0",
  "identifier": "com.tcloud.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../.next/standalone",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "TCloud — Telegram Cloud Storage",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Telegram-powered cloud storage",
    "longDescription": "TCloud — облачное хранилище файлов, использующее Telegram в качестве бессерверного бэкенда. Клиентский MTProto, AES-256-CBC шифрование, Apple Liquid Glass дизайн.",
    "publisher": "TCloud"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.tcloud.app/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": ""
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
